# ========================================
# AutoRecurso - Variáveis de Ambiente
# ========================================

# Banco de dados PostgreSQL (obrigatório)
# No Render, use a Internal Database URL fornecida pelo PostgreSQL do Render
DATABASE_URL="postgresql://user:password@localhost:5432/autorecurso"

# Segredo para assinar tokens JWT de autenticação (obrigatório)
# Gere um segredo forte com: openssl rand -base64 32
JWT_SECRET="GERE_UM_SEGREDO_FORTE_AQUI"

# Nome do sistema exibido na interface
NEXT_PUBLIC_APP_NAME="AutoRecurso - Sistema de Recursos de Trânsito"

# Chave da API do Google Gemini para o assistente Samuca (obrigatório para WhatsApp)
GEMINI_API_KEY="sua_chave_gemini_aqui"

# Número de WhatsApp oficial do atendimento (com código do país, sem +)
NEXT_PUBLIC_WHATSAPP_NUMBER="5579998340176"

# Porta do servidor (automático no Render, default: 10000)
# PORT=10000
