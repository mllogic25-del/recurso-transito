datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         String          @default("CLIENT") // "ADMIN" or "CLIENT"
  cpf          String?
  phone        String?
  address      String?
  cnh          String?
  rg           String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appeals      AppealRequest[]
  affiliateProfile Affiliate?
  referralAsReferred Referral? @relation("ReferredUser")
}

model AppealRequest {
  id                 String           @id @default(cuid())
  protocol           String           @unique
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             String           @default("PENDING") // PENDING, PROCESSING, READY, REJECTED
  type               String           @default("DEFESA_PREVIA") // DEFESA_PREVIA, JARI, CETRAN
  authority          String           // Ex: DETRAN/SP, PRF, DNIT, Órgão Municipal
  aitNumber          String           // Número do Auto de Infração
  plate              String           // Placa do veículo
  renavam            String?
  vehicleModel       String?
  ctbArticle         String           // Artigo da infração
  infractionDate     String           // Data da infração
  infractionTime     String?          // Horário
  infractionLocation String           // Local
  speedLimit         String?          // Limite regulamentado (se radar)
  speedMeasured      String?          // Velocidade medida (se radar)
  speedConsidered    String?          // Velocidade considerada (se radar)
  radarModel         String?          // Modelo / Número do Inmetro
  lastVerification   String?          // Data da última aferição
  notificationDate   String?          // Data de expedição/notificação
  defenseDeadline    DateTime?        // Data Limite da Defesa (para ordenação por prazo mais curto)
  isExpiredSubmission Boolean         @default(false) // Informa se o cliente enviou mesmo com prazo regular expirado
  defenseArguments   String           // Relato do cliente
  legalCategory      String           @default("OUTROS") // EXCESSO_VELOCIDADE, LEI_SECA, SEMAFORO, etc.
  generatedDocument  String?          // Peça jurídica gerada
  adminNotes         String?
  readyAt            DateTime?
  // Controle de Pagamento
  paymentStatus      String           @default("PENDING") // PENDING (Aguardando Pagamento), PAID (Confirmado)
  paymentAmount      Float            @default(20.00)
  paymentMethod      String?          @default("PIX")
  paymentProofUrl    String?
  paymentConfirmedAt DateTime?
  // Controle de Envio por E-mail
  sentToEmail        Boolean          @default(false)
  emailSentAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  documents          AppealDocument[]
  commissions        Commission[]
}

model AppealDocument {
  id              String        @id @default(cuid())
  appealRequestId String
  appealRequest   AppealRequest @relation(fields: [appealRequestId], references: [id], onDelete: Cascade)
  title           String
  fileName        String
  fileUrl         String
  fileType        String
  fileSize        Int
  createdAt       DateTime      @default(now())
}

model LegalTemplate {
  id                   String   @id @default(cuid())
  title                String
  category             String   @unique
  ctbArticle           String
  description          String
  defaultPreliminaries String
  defaultMerit         String
  defaultRequests      String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// Modelo do Afiliado / Indicador
model Affiliate {
  id           String       @id @default(cuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralCode String       @unique
  pixKeyType   String       @default("CPF") // CPF, EMAIL, TELEFONE, ALEATORIA
  pixKey       String
  totalEarnings Float       @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  referrals    Referral[]
  commissions  Commission[]
}

// Vínculo de Indicação (1 cliente só pode ser indicado uma única vez)
model Referral {
  id             String    @id @default(cuid())
  affiliateId    String
  affiliate      Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId String    @unique
  referredUser   User      @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)
  status         String    @default("REGISTERED") // REGISTERED, PAID_CONVERTED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Registro de Comissão de R$ 10,00 (apenas 1 vez por indicado)
model Commission {
  id              String         @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referredUserId  String
  appealRequestId String?
  appealRequest   AppealRequest? @relation(fields: [appealRequestId], references: [id], onDelete: SetNull)
  amount          Float          @default(10.00) // R$ 10,00 fixo
  status          String         @default("PENDING") // PENDING (aguardando repasse Pix), PAID (pago)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Garante que o indicador recebe no máximo uma comissão por cliente indicado
  @@unique([affiliateId, referredUserId])
}
